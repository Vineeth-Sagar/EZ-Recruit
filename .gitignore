# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/

# Environment
.env
.env.local
venv/
env/
.venv/

# Secrets — NEVER commit these
.streamlit/secrets.toml
secrets.toml

# Data — the dedup DB is ephemeral working state, kept in a GitHub Actions
# cache instead (see .github/workflows/daily_job_hunt.yml), not git history.
data/seen_jobs.db
# Reports ARE committed so the Streamlit History UI can read past runs.
!data/reports/*.xlsx

# Resumes — committed to repo (needed by GitHub Actions)
# resumes/*.pdf  ← DO NOT gitignore this line

# OS
.DS_Store
Thumbs.db
*.log

# IDE
.vscode/
.idea/
*.swp

# Keep data directory structure
!data/.gitkeep
!resumes/.gitkeep
